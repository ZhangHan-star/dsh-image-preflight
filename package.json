{
  "name": "dsh-image-preflight",
  "version": "0.1.1",
  "description": "Preflight for DSH image attachments: a lying extension or MIME alias is relabelled byte-for-byte, an oversized or unsupported-but-decodable image is re-encoded just far enough to pass admission, and everything else stays untouched.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "attachment",
    "image",
    "preflight",
    "repair",
    "admission"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./repair": "./lib/repair.js",
    "./limits": "./lib/limits.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "test": "node --test test/repair.test.mjs test/plugin.test.mjs",
    "test:unit": "node test/repair.test.mjs && node test/plugin.test.mjs",
    "test:fixtures": "node test/fixtures/generate.mjs --clean",
    "test:verify": "node test/verify.mjs",
    "test:all": "npm run test:unit && npm run test:verify"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "ZhangHan-star <ZhangHan8233@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangHan-star/dsh-image-preflight.git"
  },
  "homepage": "https://github.com/ZhangHan-star/dsh-image-preflight#readme",
  "bugs": {
    "url": "https://github.com/ZhangHan-star/dsh-image-preflight/issues"
  }
}
